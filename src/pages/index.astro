---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
    .filter(a => !a.data.draft && new Date(a.data.date) <= new Date())
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<BaseLayout title="Quote-to-Cash & CPQ Insights">
  <div class="container">
    <section class="hero">
      <p class="hero-eyebrow">Quote-to-Cash &amp; CPQ</p>
      <h1>Practical insights from the front lines of revenue operations.</h1>
      <p>I'm Carlos Ali — a Salesforce CPQ and Quote-to-Cash consultant who writes about what actually works when enterprises implement these systems at scale.</p>
    </section>

    <section class="articles-section">
      <h2>Latest Articles</h2>
      {articles.map((article) => (
        <a href={`/articles/${article.id}`} class="article-card" style="display: block; text-decoration: none;">
          <div class="article-meta">
            <span class="article-date">{formatDate(article.data.date)}</span>
            {article.data.tags[0] && <span class="article-tag">{article.data.tags[0]}</span>}
          </div>
          <h3>{article.data.title}</h3>
          <p>{article.data.description}</p>
        </a>
      ))}
    </section>

    <div class="cta-section">
      <h3>Want to talk Quote-to-Cash?</h3>
      <p>I write about CPQ implementations, Revenue Cloud migrations, and the messy reality of enterprise Q2C. Connect with me on LinkedIn.</p>
      <a href="https://linkedin.com/in/carlosali" target="_blank" rel="noopener" class="cta-button">Connect on LinkedIn</a>
    </div>
  </div>
</BaseLayout>
